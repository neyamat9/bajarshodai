# Bazar Shodai storefront: copy this file to ".env.local" and fill it in.

# Backend API base URL, including /api (no trailing slash).
# Also builds the image allow-list at build time, so restart or rebuild after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Public URL of this storefront (no trailing slash). Used for page metadata,
# sitemap, share previews and location-share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Must be the SAME value as REVALIDATE_SECRET in server/.env.
# Lets the API refresh cached pages the moment an admin saves something.
# Without it the pages simply refresh themselves every 5 minutes.
REVALIDATE_SECRET=
