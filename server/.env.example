# =====================================================================
# Bazar Shodai API: copy this file to ".env" and fill it in.
# Real .env files are git-ignored. Never commit secrets.
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =====================================================================

# ---- Server ----
NODE_ENV=development
PORT=8000
API_PREFIX=api
# Number of proxies in front of the app (0 or 1). Needed for correct client IPs and rate limits.
TRUST_PROXY=1
# The shop works in Bangladesh time (order numbers, daily reports).
TZ=Asia/Dhaka

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Optional. A direct (non-pooled) connection used for `prisma migrate`.
# Needed with Neon's pooled URL. Falls back to DATABASE_URL when empty.
# DATABASE_URL_DIRECT=

# ---- Secrets: long random values, all different from each other ----
JWT_SECRET=
JWT_SECRET_REFRESH=
JWT_EXPIRES_IN=1d
# Encrypts payment, email and map secrets saved from the dashboard settings.
# Changing it later means re-entering those secrets in the dashboard.
SETTINGS_ENCRYPTION_KEY=
# Needed once to create the first admin (POST /api/admin/auth/seed-admin). Remove afterwards.
ADMIN_SEED_SECRET=
# Must be the SAME value as REVALIDATE_SECRET in frontend/.env.local.
# Lets the API refresh the storefront's cached pages the moment an admin saves something.
REVALIDATE_SECRET=

# ---- First Super Admin, created by `npx prisma db seed` (remove these afterwards) ----
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_PHONE=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# ---- CORS and links used in emails (no trailing slash) ----
# Comma-separated: storefront and dashboard URLs
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000
RESET_PASSWORD_PATH=/reset-password
ADMIN_URL=http://localhost:5173
ADMIN_RESET_PASSWORD_PATH=/reset-password
PASSWORD_RESET_TTL_MINUTES=30

# ---- Email (can also be set in dashboard Settings > Email) ----
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Bazar Shodai <no-reply@example.com>"

# ---- Uploads ----
# Folder for uploaded images. Use a persistent disk in production.
UPLOAD_DIR=./uploads
# Public base URL of this API (no trailing slash) so image URLs are absolute.
UPLOADS_PUBLIC_URL=http://localhost:8000
# UPLOAD_CLEANUP_INTERVAL_MS=3600000
# UPLOAD_UNATTACHED_TTL_MS=86400000

# ---- Rate limiting: THROTTLE_LIMIT requests per THROTTLE_TTL seconds per IP ----
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# ---- Docs / debugging: keep off in production ----
SWAGGER_ENABLED=true
GRAPHQL_PLAYGROUND=false
GRAPHQL_INTROSPECTION=false

# ---- Activity log ----
ACTIVITY_LOG_RETENTION_DAYS=365
ACTIVITY_LOG_BEHAVIOR_RETENTION_DAYS=30
ACTIVITY_LOG_ADMIN_READS=false

# ---- Location sharing and maps (used by the location and delivery features) ----
# How long a "share your location" link stays valid.
LOCATION_LINK_TTL_HOURS=24
# Starting values only. After the first start, Dashboard > Settings > Maps decides.
# Provider: osm | google
MAPS_PROVIDER=osm
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
ORS_API_KEY=
OSM_TILE_URL=
# Contact email sent in the User-Agent to OpenStreetMap services (their usage policy asks for one).
OSM_CONTACT_EMAIL=

# ---- SMS (later: OTP login and order SMS) ----
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER_ID=

# ---- Background jobs (ms). Defaults are fine; they run inside the server process. ----
# DISCOUNT_SCHEDULER_INTERVAL_MS=
# BACK_IN_STOCK_INTERVAL_MS=
