# =====================================================================
# Bazar Shodai Mobile App - Environment Configuration Template
# Copy this file to ".env" in the bazar-shodai-app directory.
# All client-accessible Expo variables MUST start with EXPO_PUBLIC_
# =====================================================================

# Backend API base URL (including /api, without trailing slash)
# Production / Deployed API:
EXPO_PUBLIC_API_BASE_URL=https://bazar-shodai-api.onrender.com/api

# Local Development options:
# Android Emulator: http://10.0.2.2:8000/api
# Physical Device on local Wi-Fi: http://192.168.x.x:8000/api

# Public Storefront Website URL
EXPO_PUBLIC_SITE_URL=https://bazarshodai.com

