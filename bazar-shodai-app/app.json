{
  "expo": {
    "name": "Bazar Shodai",
    "slug": "bazar-shodai-app",
    "scheme": "bajarshodai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#0b6234",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b6234"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bajarshodai.app",
      "buildNumber": "1",
      "jsEngine": "hermes",
      "infoPlist": {
        "NSCameraUsageDescription": "Bazar Shodai needs camera access so you can take photos of damaged items for refund claims and upload medicine prescriptions.",
        "NSPhotoLibraryUsageDescription": "Bazar Shodai needs photo library access so you can upload medicine prescriptions, avatar pictures, and return evidence.",
        "NSLocationWhenInUseUsageDescription": "Bazar Shodai needs your location to deliver fresh groceries directly to your exact doorstep in Shahrasti.",
        "NSFaceIDUsageDescription": "Bazar Shodai uses Face ID for fast and secure biometric checkout authentication."
      }
    },
    "android": {
      "package": "com.bajarshodai.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0b6234",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "jsEngine": "hermes",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store",
      "expo-image",
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bazar Shodai needs your location to deliver fresh groceries directly to your exact doorstep."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bazar Shodai needs photo library access to upload prescriptions and return evidence photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0b6234"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Bazar Shodai to use Face ID for biometric authentication."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6ba38596-857a-423e-8e6e-21baa33675ea"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6ba38596-857a-423e-8e6e-21baa33675ea"
    }
  }
}
