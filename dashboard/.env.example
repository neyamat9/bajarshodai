# Bazar Shodai admin dashboard: copy this file to ".env" and fill it in.

# Backend API base URL, including /api (no trailing slash).
# Baked in at build time, so rebuild after changing it.
VITE_API_URL=http://localhost:8000/api

# Public storefront URL (used by the "View store" link)
VITE_PUBLIC_SITE_URL=http://localhost:3000
